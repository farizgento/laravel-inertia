[program:laravel-worker]
process_name=%(program_name)s_%(process_num)02d
directory=/var/www/laravel-inertia
command=php artisan queue:work database --queue=default --sleep=3 --tries=3 --timeout=1200 --max-jobs=1
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/laravel-inertia/storage/logs/worker.log
stopwaitsecs=1260

